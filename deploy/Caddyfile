# متجر برو — edge configuration
#
# This is what makes a merchant's own domain work over HTTPS with no manual
# step. Caddy obtains and renews a certificate the first time a real request
# arrives for an unknown hostname, but only for hostnames our API vouches for.
#
# Deploy: caddy run --config deploy/Caddyfile
# The app itself must be reachable on 127.0.0.1:8000 (php-fpm behind Caddy, or
# an app server — this file assumes the former).

{
	email ops@matgarpro.com

	# Off the network. By default the admin API listens on localhost:2019 and
	# answers an unauthenticated `POST /stop` — one request from anything on
	# this box that can be talked into making it (a merchant-supplied webhook
	# URL, say) takes every store offline. A socket only root and caddy can
	# open still lets `caddy reload` work.
	admin unix//var/lib/caddy/admin.sock

	on_demand_tls {
		# Caddy calls this BEFORE asking the CA for a certificate. A 2xx means
		# the hostname belongs to a real store; anything else refuses the
		# handshake. Without this gate, anyone could point a few thousand
		# hostnames at our IP and burn through the CA's rate limit in minutes.
		ask http://127.0.0.1:8000/api/tls/check

		# Ceiling on how fast new certificates may be issued, as a second line
		# of defence if the ask endpoint is ever misconfigured.
		interval 2m
		burst 8
	}
}

# ---------------------------------------------------------------------------
# The dashboard. Named explicitly so it is never served on a merchant domain.
# ---------------------------------------------------------------------------
app.matgarpro.com {
	# NOTE: must match the deploy path on the server. Renamed with the rest of
	# the rebrand — confirm with `ls /var/www` before reloading Caddy, because
	# a wrong root here serves a 404 for every store at once.
	root * /var/www/matgarpro/public
	encode zstd gzip
	php_fastcgi unix//run/php/php8.3-fpm.sock
	file_server
}

# ---------------------------------------------------------------------------
# Every store: the free {slug}.matgarpro.com sub-domain (one wildcard
# certificate) plus any custom domain, each getting its own certificate on
# demand.
# ---------------------------------------------------------------------------
*.matgarpro.com, https:// {
	tls {
		on_demand
	}

	# NOTE: must match the deploy path on the server. Renamed with the rest of
	# the rebrand — confirm with `ls /var/www` before reloading Caddy, because
	# a wrong root here serves a 404 for every store at once.
	root * /var/www/matgarpro/public
	encode zstd gzip

	# Storefront pages are paid for with ad money — a slow first byte is a
	# measurable share of the merchant's budget.
	header {
		-Server
		# No includeSubDomains: this block also answers on merchants' own
		# domains, and pinning HTTPS onto every sub-domain of a shop's brand
		# — their mail panel, their old blog — is not ours to decide.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@static {
		path /build/* /storage/* *.css *.js *.woff2 *.png *.jpg *.svg *.webp
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi unix//run/php/php8.3-fpm.sock
	file_server
}
