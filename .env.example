APP_NAME="متجر برو"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

# ---- Storefront -------------------------------------------------------------
# Stores live on {slug}.STOREFRONT_DOMAIN and keep that address forever.
STOREFRONT_DOMAIN=matgarpro.test

# The dashboard answers ONLY on this host. Leaving it empty makes the dashboard
# respond on every hostname, including merchants' own domains.
STOREFRONT_APP_DOMAIN=localhost

# Where merchants point their DNS. Comma-separated list of every edge IP that
# may serve storefront traffic.
STOREFRONT_DNS_A=127.0.0.1
STOREFRONT_DNS_CNAME=connect.matgarpro.com

# ---- Billing ----------------------------------------------------------------
BILLING_CURRENCY=EGP
BILLING_DEFAULT_PRICE_PER_ORDER=0
BILLING_OVERDRAFT_LIMIT=25
BILLING_LOW_BALANCE_THRESHOLD=50
# First 3 months: 0.25 off the plan price (0.75 -> 0.50). A sent WhatsApp
# confirmation adds 0.50 to that order.
BILLING_INTRO_MONTHS=3
BILLING_INTRO_DISCOUNT=0.25
BILLING_WHATSAPP_CONFIRMATION_FEE=0.50
# Merchants transfer top-ups here and send the receipt on WhatsApp to it.
BILLING_INSTAPAY_NUMBER=01006262330

# ---- AI ---------------------------------------------------------------------
# Empty key = AI features say "unavailable" instead of failing.
# AI jobs run on their own queue: php artisan queue:work --queue=ai
ANTHROPIC_API_KEY=
AI_DAILY_COST_CAP_USD=1.00
AI_PRODUCT_WRITER_DAILY_LIMIT=20

# ---- Platform WhatsApp number -----------------------------------------------
# The official number every store can switch on with one click. All from the
# Meta app's WhatsApp → API Setup page (token: a System User token, not the
# 24-hour one). Empty = the option is not offered to merchants.
# Webhook to set in the Meta app: {APP_URL}/api/integrations/whatsapp/platform
# Then create the template once: php artisan whatsapp:platform-template
PLATFORM_WHATSAPP_TOKEN=
PLATFORM_WHATSAPP_PHONE_NUMBER_ID=
PLATFORM_WHATSAPP_WABA_ID=
PLATFORM_WHATSAPP_APP_SECRET=
PLATFORM_WHATSAPP_VERIFY_TOKEN=

# ---- WAHA (stores link their own number by QR) -----------------------------
# Our self-hosted gateway — see deploy/waha/docker-compose.yml. Empty = the
# option is not offered. CALLBACK_URL is how WAHA reaches this app (on a local
# Docker setup: http://host.docker.internal:8000).
WAHA_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_CALLBACK_URL=

# What a sent WhatsApp confirmation adds to an order, per channel (EGP).
BILLING_WHATSAPP_FEE_META=0.50
BILLING_WHATSAPP_FEE_WAHA=0.25

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matgarpro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
